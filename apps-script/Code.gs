const STATUSES_ = ['not_started', 'in_progress', 'review', 'done', 'waiting'];
const STORE_PREFIX_ = 'bicycle_board_v1:';

function doGet() {
  return HtmlService.createHtmlOutputFromFile('Index')
    .setTitle('Bicycle Lab · พื้นที่ทำงานของทีม')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function readProgress_(properties, id) {
  const raw = properties[STORE_PREFIX_ + id];
  if (!raw) return { status: 'not_started', note: '', evidence: '', revision: 0,
                     updatedAt: null, updatedBy: null };
  let progress;
  try { progress = JSON.parse(raw); } catch (error) {
    throw new Error('อ่านสถานะงาน ' + id + ' ไม่ได้ โปรดแจ้งผู้ดูแลก่อนแก้ไข');
  }
  if (!progress || !STATUSES_.includes(progress.status) ||
      !Number.isSafeInteger(progress.revision) || progress.revision < 1 ||
      typeof progress.note !== 'string' || typeof progress.evidence !== 'string') {
    throw new Error('ข้อมูลสถานะงาน ' + id + ' ไม่สมบูรณ์ โปรดแจ้งผู้ดูแล');
  }
  return progress;
}

function getBoard() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) throw new Error('มีเพื่อนกำลังบันทึก กรุณาลองโหลดอีกครั้ง');
  try {
    const properties = PropertiesService.getScriptProperties().getProperties();
    return { roles: PROJECT_.roles, phases: PROJECT_.phases,
      resources: PROJECT_.resources, gates: PROJECT_.gates,
      tasks: PROJECT_.tasks.map(function(task) {
        return Object.assign({}, task, { progress: readProgress_(properties, task.id) });
      }), loadedAt: new Date().toISOString() };
  } finally { lock.releaseLock(); }
}

function saveTask(payload) {
  if (!payload || typeof payload !== 'object' || Array.isArray(payload))
    throw new Error('ข้อมูลที่ส่งมาไม่ถูกต้อง กรุณาเปิดงานใหม่');
  const task = PROJECT_.tasks.find(function(item) { return item.id === payload.id; });
  if (!task) throw new Error('ไม่พบงานที่ต้องการแก้ไข');
  if (!STATUSES_.includes(payload.status)) throw new Error('เลือกสถานะจากรายการที่กำหนด');
  if (!['M1', 'M2', 'M3', 'M4', 'M5'].includes(payload.role))
    throw new Error('เลือกบทบาทผู้บันทึก M1–M5 ก่อน');
  if (!Number.isSafeInteger(payload.expectedRevision) || payload.expectedRevision < 0)
    throw new Error('รุ่นข้อมูลไม่ถูกต้อง กรุณาเปิดงานใหม่');
  if (typeof payload.note !== 'string' || payload.note.length > 400)
    throw new Error('บันทึกสั้น ๆ ได้ไม่เกิน 400 ตัวอักษร');
  if (typeof payload.evidence !== 'string' || payload.evidence.length > 1500)
    throw new Error('ลิงก์หลักฐานยาวเกิน 1,500 ตัวอักษร');
  const note = payload.note.trim(), evidence = payload.evidence.trim();
  if (evidence && !/^https:\/\/[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::\d{1,5})?(?:[/?#][^\s<>"']*)?$/i.test(evidence))
    throw new Error('ลิงก์หลักฐานต้องขึ้นต้นด้วย https:// และไม่มีช่องว่าง');
  if (payload.status === 'done' && !note && !evidence)
    throw new Error('เพิ่มบันทึกผลหรือหลักฐานก่อนเปลี่ยนเป็นเสร็จแล้ว');
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) throw new Error('มีเพื่อนกำลังบันทึก กรุณาลองอีกครั้ง');
  try {
    const store = PropertiesService.getScriptProperties();
    const properties = store.getProperties();
    const current = readProgress_(properties, task.id);
    if (current.revision !== payload.expectedRevision)
      return { ok: false, conflict: true, current: current,
        message: 'มีเพื่อนแก้งานนี้แล้ว บันทึกของคุณยังอยู่ โปรดโหลดสถานะล่าสุดก่อนส่งใหม่' };
    const blocked = task.dependencies.filter(function(id) {
      return !isCompleted_(id, properties, {});
    });
    if (blocked.length && ['review', 'done'].includes(payload.status))
      throw new Error('ยังส่งตรวจหรือปิดงานไม่ได้ รอให้งานก่อนหน้าเสร็จ: ' + blocked.join(', '));
    const next = { status: payload.status, note: note, evidence: evidence,
      revision: current.revision + 1, updatedAt: new Date().toISOString(), updatedBy: payload.role };
    // Per-task properties keep each value comfortably below the service limit.
    store.setProperty(STORE_PREFIX_ + task.id, JSON.stringify(next));
    return { ok: true, taskId: task.id, progress: next };
  } finally { lock.releaseLock(); }
}

function isCompleted_(id, properties, trail) {
  const task = PROJECT_.tasks.find(function(item) { return item.id === id; });
  if (!task || trail[id]) return false;
  if (readProgress_(properties, id).status !== 'done') return false;
  const next = Object.assign({}, trail); next[id] = true;
  return task.dependencies.every(function(dependency) {
    return isCompleted_(dependency, properties, next);
  });
}
